{
  "name": "defi-liquidity-rebalancer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "CLI tool for initializing or updating liquidity positions",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli/main.ts",
    "mnemonic-to-private-key": "tsx src/scripts/mnemonic-to-private-key.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "start": "node dist/cli/main.js",
    "start:pretty": "LOG_FORMAT=pretty LOG_LEVEL=debug node dist/cli/main.js",
    "start:json": "LOG_FORMAT=json LOG_LEVEL=info node dist/cli/main.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test 'tests/**/*.test.ts'",
    "test:typecheck": "tsc -p tests/tsconfig.json"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "eslint": "^10.8.0",
    "eslint-plugin-prettier": "^5.5.6",
    "prettier": "^3.9.6",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.66.0"
  },
  "dependencies": {
    "@scure/bip39": "^1.6.0",
    "@uniswap/v3-sdk": "^3.31.1",
    "jsbi": "^3.2.5",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "viem": "^2.55.10"
  },
  "volta": {
    "node": "22.18.0",
    "yarn": "1.22.22"
  }
}
